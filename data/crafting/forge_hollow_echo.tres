[sub_resource type="Resource" id="Cost_bog_iron"]
script = ExtResource("2_cost")
material = ExtResource("3_iron")
count = 2

[resource]
script = ExtResource("1_recipe")
id = &"forge.hollow_echo"
display_name = "Hollow Echo"
description = "Forge the Hollow Echo fitting for Pilgrim's Edge. Once crafted it is yours: fit or remove it at the Forge anvil, free of charge."
station = 0
kind = 2
