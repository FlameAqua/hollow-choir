mastery_weapons = Array[ExtResource("4_weapon")]([ExtResource("5_edge"), ExtResource("6_maul"), ExtResource("7_bow")])
weapon = ExtResource("5_edge")
fittings = Array[ExtResource("8_fitting")]([ExtResource("9_fitting")])
