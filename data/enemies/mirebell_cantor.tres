[resource]
script = ExtResource("8_di2bd")
role = 5
tier = 2
species = "Bloom-grown bell-ward"
habitat = "The drowned chapel at the heart of Briarfen."
lore = "The bell was cast to keep the Bloom out. The Bloom grew around it anyway, and learned to sing."
max_stagger = 90.0
stagger_growth_on_break = 1.2
has_weak_point = true
weak_point_name = "Cracked Bell"
actions = Array[ExtResource("1_o28tj")]([SubResource("Resource_xcl1g"), SubResource("Resource_pxo75"), SubResource("Resource_kwf3r")])
