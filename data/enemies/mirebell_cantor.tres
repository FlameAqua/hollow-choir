ai_tendencies = "Floods the hollow at 70%, sings a Requiem at 45% (break it!), and gambles everything on a parryable Final Knell near the end."
rare_interactions = "Parrying the Final Knell breaks it outright. The bell is exposed while it sings the Requiem."
id = &"mirebell_cantor"
display_name = "The Mirebell Cantor"
description = "Once a Choir bell-ward. Now a mountain of fungus grown around its fallen bell. It still rings the hours."
